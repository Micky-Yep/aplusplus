let score = 72.5;
const passed = score >= 50 && true;
show "Score:", score, passed;

fn add(number: left, number: right) -> number {
    return left + right;
}

let result = add(3,4);
let nums = [1,2,3];
nums[0] =50;
show result, nums[0], nums.length;

setclass Student start
    public let age =20;
    public fn getAge() -> number {
        return self.age;
    }
:end

let student = spawn Student [age = 21];
show student.getAge();

when(score >= 80) {
    show "HD";
} default {
    show "Pass";
}

let count = 0;
loop {
    count = count + 1;
} until(count >= 2);